{
  "name": "variantscope",
  "productName": "VariantScope",
  "version": "0.1.0",
  "description": "Explore where disease-linked protein variants cluster, using AlphaFold, ClinVar and gnomAD. Educational use only.",
  "author": "reeper316099",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "homepage": "https://github.com/reeper316099/VariantScope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeper316099/VariantScope.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:web": "vite build",
    "build:electron": "vite build --mode electron",
    "build:e2e": "vite build --mode e2e",
    "start:electron": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "test": "vitest run",
    "test:e2e": "npm run build:electron && playwright test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.1.0",
    "3dmol": "2.5.5",
    "chart.js": "4.6.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
